<%=t 'autoprogress.greeting' %>

<p><label><%=t 'autoprogress.projects.label' %>: </label>
  <%= select_tag 'settings[projects][]',
    options_from_collection_for_select(Project.all.sort, 'id', 'name', @settings['projects']),
    { multiple: true, size: 10} %>
</p>

<% if Issue.respond_to?(:available_tags) %>
<p><label><%=t 'autoprogress.tag.label' %>: </label>
  <% autoprogress_tags = Issue.available_tags.collect{|u| [u.name, u.name]}.sort.uniq %>
  <% autoprogress_tag = @settings['tag'] if autoprogress_tags.any? {|_, name| name == @settings['tag']} %>
  <%= select_tag 'settings[tag]',
    options_for_select(autoprogress_tags, autoprogress_tag || ''),
    include_blank: true %>
</p>
<% end %>
